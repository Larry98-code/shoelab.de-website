{
  // ShoeLab.de — Cloudflare Pages configuration.
  // Pages reads this file on every Git deploy. The D1 binding below is applied
  // automatically, so it does not need to be set in the dashboard.
  "name": "shoelab-de-website",
  "compatibility_date": "2025-05-01",
  // Static site: no build step. Output dir is this folder (relative to this file).
  "pages_build_output_dir": ".",
  // D1 database for accounts, bookings, contact messages and reviews.
  // Bound as env.DB inside functions/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoelab",
      "database_id": "f3465854-9f04-4bff-817f-17bd0707be01"
    }
  ]
}
